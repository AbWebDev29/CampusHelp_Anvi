      </div>
      <p class="college-table-note">This is a selected list of major institutions, not a complete directory of every private engineering college in India. Exam dates shown are 2026 cycle dates; future cycle dates are announced by each institution and exam authority.</p>
    </section>
  </div>

    <aside class="split-view-panel" id="campusSplitView" aria-label="Split view" aria-hidden="true">
      <div class="split-view-toolbar">
        <button type="button" id="closeSplitView">Back to CampusHelp</button>
        <span class="split-view-title" id="splitViewTitle">Linked page</span>
        <a id="openSplitTarget" href="#" target="_blank" rel="noopener noreferrer">Open separately ↗</a>
      </div>
      <div class="split-view-hint">If the website blocks embedded viewing, use “Open separately” to view it in another tab.</div>
      <iframe class="split-view-frame" id="splitViewFrame" title="Linked page"></iframe>
    </aside>

    <script>
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('.copy-field-button');
      if (!button) return;

      const value = button.dataset.copyKind === 'subjects'
        ? Array.from(button.closest('.entry-field').querySelectorAll('.subject-chips span'))
            .map((subject) => subject.textContent.trim()).join(', ')
        : button.dataset.copy || '';
      const originalLabel = button.textContent;
      const originalAriaLabel = button.getAttribute('aria-label');
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
        } else {
          const temporaryInput = document.createElement('textarea');
          temporaryInput.value = value;
          temporaryInput.setAttribute('readonly', '');
          temporaryInput.style.position = 'fixed';
          temporaryInput.style.opacity = '0';
          document.body.appendChild(temporaryInput);
          temporaryInput.select();
          const copied = document.execCommand('copy');
          temporaryInput.remove();
          if (!copied) throw new Error('Clipboard copy failed');
        }
        button.textContent = 'Copied';
        button.setAttribute('aria-label', 'Copied to clipboard');
      } catch (error) {
        button.textContent = 'Retry';
        button.setAttribute('aria-label', 'Copy failed. Retry');
      }
      button.disabled = true;
      window.setTimeout(() => {
        button.textContent = originalLabel;
        button.disabled = false;
        button.setAttribute('aria-label', originalAriaLabel);
      }, 1400);
    });

    function openSplitScreen(targetUrl) {
      const frame = document.getElementById('splitViewFrame');
      const panel = document.getElementById('campusSplitView');
      const link = Array.from(document.querySelectorAll('a[href]')).find((item) => item.href === targetUrl);
      const title = document.getElementById('splitViewTitle');
      const separateLink = document.getElementById('openSplitTarget');
      frame.src = targetUrl;
      frame.title = link ? link.textContent.trim() : 'Linked page';
      title.textContent = link ? link.textContent.trim() : targetUrl;
      separateLink.href = targetUrl;
      document.body.classList.add('split-view-active');
      panel.setAttribute('aria-hidden', 'false');
      document.getElementById('closeSplitView').focus();
      return false;
    }

    function closeSplitScreen() {
      const panel = document.getElementById('campusSplitView');
      document.body.classList.remove('split-view-active');
      panel.setAttribute('aria-hidden', 'true');
      document.getElementById('splitViewFrame').src = 'about:blank';
    }

    document.getElementById('closeSplitView').addEventListener('click', closeSplitScreen);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && document.body.classList.contains('split-view-active')) closeSplitScreen();
    });

    // Keep every extension-page link in the same-browser side-by-side workflow.
    document.addEventListener('click', (event) => {
      const link = event.target.closest('a[href]');
      if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (link.closest('#campusSplitView') || link.closest('.campus-frame-header') || link.closest('.user-info')) return;

      const targetUrl = link.getAttribute('href');
      if (!targetUrl || targetUrl.startsWith('#') || !/^https?:\/\//i.test(link.href)) return;

      event.preventDefault();
      openSplitScreen(link.href);
    });

    // scroll‑driven triangle motion
    const triangle1 = document.getElementById('triangle1');
    const triangle2 = document.getElementById('triangle2');

    const initialRotation1 = 325.932;
    const initialRotation2 = 251.777;

    let ticking = false;

    function updateTriangles() {
      const scrollY = window.scrollY || window.pageYOffset;
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      const maxScroll = documentHeight - windowHeight || 1;

      const scrollPercent = Math.min(1, Math.max(0, scrollY / maxScroll));

      const rotate1 = initialRotation1 + scrollPercent * 180;
      const translateX1 = scrollPercent * 60;
      const translateY1 = Math.sin(scrollPercent * Math.PI * 2) * 30;
      const scale1 = 1 + Math.sin(scrollPercent * Math.PI * 2) * 0.06;

      const rotate2 = initialRotation2 - scrollPercent * 180;
      const translateX2 = -scrollPercent * 60;
      const translateY2 = Math.cos(scrollPercent * Math.PI * 2) * 30;
      const scale2 = 1 + Math.cos(scrollPercent * Math.PI * 2) * 0.06;

      triangle1.style.transform = `
        translate(-40%, 40%)
        translate(${translateX1}px, ${translateY1}px)
        rotate(${rotate1}deg)
        scale(${scale1})
      `;

      triangle2.style.transform = `
        translate(40%, -40%)
        translate(${translateX2}px, ${translateY2}px)
        rotate(${rotate2}deg)
        scale(${scale2})
      `;

      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        window.requestAnimationFrame(updateTriangles);
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestTick);
    window.addEventListener('resize', updateTriangles);
    updateTriangles();
  </script>
  <footer class="campus-frame-footer"><span>CampusHelp · Your college journey, organized</span><span>Welcome · Profile · Workspace</span></footer>
</body>
</html>

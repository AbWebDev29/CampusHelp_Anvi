            <tr><td>BITS Pilani, Goa &amp; Hyderabad</td><td>BITSAT 2026 (two sessions)</td><td>15 Dec 2025–19 Mar 2026; session-II registration also available</td><td>Session I: 15–16 Apr; Session II: 24–26 May 2026</td><td>Scores and admission iterations published through the portal</td><td><a href="https://www.bitsadmission.com/BITSAT_LP/index.html" target="_blank" rel="noopener noreferrer">BITS admissions</a></td></tr>
            <tr><td>Manipal Institute of Technology (MAHE)</td><td>MET 2026</td><td>Phase I to 23 Mar; Phase II to 26 Apr 2026</td><td>Phase I: 13–14 Apr; Phase II: 23–24 May 2026</td><td>Merit list / counselling schedule published in June</td><td><a href="https://www.manipal.edu/entrancetest.html" target="_blank" rel="noopener noreferrer">MAHE entrance tests</a></td></tr>
            <tr><td>SRM Institute of Science and Technology (SRMIST)</td><td>SRMJEEE 2026</td><td>Phase I deadline: 16 Apr 2026; later phases had separate registrations</td><td>Phase I: 24–29 Apr 2026; later phases in June and July</td><td>Phase-wise results and counselling through SRM portal</td><td><a href="https://www.srmist.edu.in/admission-india/" target="_blank" rel="noopener noreferrer">SRM admissions</a></td></tr>
            <tr><td>Kalinga Institute of Industrial Technology (KIIT), Bhubaneswar</td><td>KIITEE 2026</td><td>Phase I deadline: 8 Apr; later phases through the year</td><td>Phase I: 16–20 Apr; further phases ran through Aug 2026</td><td>Phase-wise results; check current seat-allotment notices</td><td><a href="https://kiitee.kiit.ac.in/calendar-of-events/" target="_blank" rel="noopener noreferrer">KIITEE calendar</a></td></tr>
            <tr><td>Amrita Vishwa Vidyapeetham (engineering campuses)</td><td>AEEE 2026 or JEE Main 2026</td><td>Phase-based registration; dates vary by phase</td><td>AEEE Phase I: 30 Jan–1 Feb; Phase II: 24–30 Apr 2026</td><td>Rank list and CSAP counselling via admissions portal</td><td><a href="https://www.amrita.edu/admissions/engineering/" target="_blank" rel="noopener noreferrer">Amrita engineering admissions</a></td></tr>
            <tr><td>Chandigarh University</td><td>CUCET 2026 (B.E./B.Tech); qualifying routes depend on programme</td><td>25 Oct 2025–30 Sep 2026</td><td>Online exam available through 1 Oct 2026</td><td>Phase-wise result / scholarship status via CUCET portal</td><td><a href="https://cucet.cuchd.in/index.aspx" target="_blank" rel="noopener noreferrer">CUCET admissions</a></td></tr>
            <tr><td>Lovely Professional University (LPU), Punjab</td><td>LPUNEST; JEE Main / CUET may also qualify for selected programmes</td><td>Multiple schedules; confirm programme-specific deadlines</td><td>Multiple test slots and phases in 2026</td><td>Score and scholarship outcome via applicant portal</td><td><a href="https://www.lpu.in/nest/btech/" target="_blank" rel="noopener noreferrer">LPUNEST B.Tech</a></td></tr>

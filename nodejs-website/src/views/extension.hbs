            <tr><td>UPES, Dehradun</td><td>UPESEAT, JEE Main, CUET, SAT or qualifying-board route (programme dependent)</td><td>2026 admission cycle closed; see official portal for next cycle</td><td>UPESEAT slots / accepted scores vary by admission route</td><td>2026 cycle closed</td><td><a href="https://www.upes.ac.in/admissions/admission-alerts/upeseat" target="_blank" rel="noopener noreferrer">UPES B.Tech admissions</a></td></tr>
            <tr><td>R.V. College of Engineering (RVCE), Bengaluru</td><td>COMEDK UGET / KCET; other quotas have separate criteria</td><td>COMEDK: 3 Feb–23 Mar 2026</td><td>COMEDK UGET: 9 May 2026</td><td>COMEDK scorecard released 29 May; counselling separately</td><td><a href="https://rvce.edu.in/" target="_blank" rel="noopener noreferrer">RVCE official site</a></td></tr>
            <tr><td>Ramaiah Institute of Technology, Bengaluru</td><td>COMEDK UGET / KCET; quota-specific admission process</td><td>COMEDK: 3 Feb–23 Mar 2026</td><td>COMEDK UGET: 9 May 2026</td><td>COMEDK scorecard released 29 May; counselling separately</td><td><a href="https://www.msrit.edu/admissions.html" target="_blank" rel="noopener noreferrer">Ramaiah admissions</a></td></tr>
            <tr><td>BMS College of Engineering, Bengaluru</td><td>COMEDK UGET / KCET; quota-specific admission process</td><td>COMEDK: 3 Feb–23 Mar 2026</td><td>COMEDK UGET: 9 May 2026</td><td>COMEDK scorecard released 29 May; counselling separately</td><td><a href="https://bmsce.ac.in/" target="_blank" rel="noopener noreferrer">BMSCE official site</a></td></tr>
            <tr><td>Dayananda Sagar College of Engineering, Bengaluru</td><td>COMEDK UGET / KCET; quota-specific admission process</td><td>COMEDK: 3 Feb–23 Mar 2026</td><td>COMEDK UGET: 9 May 2026</td><td>COMEDK scorecard released 29 May; counselling separately</td><td><a href="https://admissions.dsce.edu.in/" target="_blank" rel="noopener noreferrer">DSCE admissions</a></td></tr>
